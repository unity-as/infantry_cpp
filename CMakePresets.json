{
    "version": 8,
    "configurePresets": [
        {
            "name": "default",
            "displayName": "default",
            "description": " 默认交叉编译工具 ",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "Clang 21.1.1 x86_64-w64-windows-gnu (ucrt64)",
            "displayName": "Clang 21.1.1 x86_64-w64-windows-gnu (ucrt64)",
            "description": "正在使用编译器: C = D:\\msys2\\ucrt64\\bin\\clang.exe, CXX = E:\\msys2\\ucrt64\\bin\\clang++.exe",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "D:/msys2/ucrt64/bin/clang.exe",
                "CMAKE_CXX_COMPILER": "D:/msys2/ucrt64/bin/clang++.exe",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default"
        }
    ]
}